# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Sui Network Configuration
NETWORK=testnet
PACKAGE_ID=0xYOUR_PACKAGE_ID
SYSTEM_OBJECT_ID=0xYOUR_SYSTEM_OBJECT_ID

# Server Private Key (for signing transactions)
# Format: suiprivkey1... (bech32) or 64-character hex string
SERVER_PRIVATE_KEY=your_private_key_here









