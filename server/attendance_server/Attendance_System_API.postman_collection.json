{
	"info": {
		"_postman_id": "attendance-system-api",
		"name": "ESP32 Sui Attendance System API",
		"description": "Complete API collection for testing the ESP32 Sui Attendance System Server",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Check server status and Sui account info"
			},
			"response": []
		},
		{
			"name": "Attendance",
			"item": [
				{
					"name": "Submit Attendance",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cardId\": \"{{cardId}}\",\n  \"orgObjectId\": \"{{orgObjectId}}\",\n  \"deviceId\": \"ESP32_ATTENDANCE_001\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance"
							]
						},
						"description": "Submit an attendance event from ESP32 device"
					},
					"response": []
				},
				{
					"name": "Get All Attendance Events",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/attendance?limit=100&offset=0",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance"
							],
							"query": [
								{
									"key": "limit",
									"value": "100",
									"description": "Number of events to return (max 1000)"
								},
								{
									"key": "offset",
									"value": "0",
									"description": "Number of events to skip"
								}
							]
						},
						"description": "Get all attendance events (paginated)"
					},
					"response": []
				},
				{
					"name": "Get Attendance by Organisation",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/attendance/{{orgObjectId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"{{orgObjectId}}"
							]
						},
						"description": "Get all attendance events for a specific organisation"
					},
					"response": []
				},
				{
					"name": "Get Attendance by Card ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/attendance/{{orgObjectId}}/card/{{cardId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"{{orgObjectId}}",
								"card",
								"{{cardId}}"
							]
						},
						"description": "Get all attendance events for a specific card ID in an organisation"
					},
					"response": []
				}
			],
			"description": "Endpoints for managing attendance events"
		},
		{
			"name": "Organisations",
			"item": [
				{
					"name": "Get Organisation Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/organisations/{{orgObjectId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"organisations",
								"{{orgObjectId}}"
							]
						},
						"description": "Get organisation details including subscription status"
					},
					"response": []
				},
				{
					"name": "Get Organisation Subscription",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/organisations/{{orgObjectId}}/subscription",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"organisations",
								"{{orgObjectId}}",
								"subscription"
							]
						},
						"description": "Get subscription status for an organisation"
					},
					"response": []
				},
				{
					"name": "Get Student by Card ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/organisations/{{orgObjectId}}/students/{{cardId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"organisations",
								"{{orgObjectId}}",
								"students",
								"{{cardId}}"
							]
						},
						"description": "Get student information by card ID"
					},
					"response": []
				}
			],
			"description": "Endpoints for managing organisations and students"
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:4000",
			"type": "string"
		},
		{
			"key": "orgObjectId",
			"value": "0xb194a44e68b2ef1b9fe9f4c....",
			"type": "string"
		},
		{
			"key": "cardId",
			"value": "NFC-100",
			"type": "string"
		}
	]
}

