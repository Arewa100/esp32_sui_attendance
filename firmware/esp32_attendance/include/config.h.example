/*
 * Configuration Header File Template
 * 
 * Copy this file to config.h and update the values below
 * DO NOT commit config.h to version control (it's in .gitignore)
 */

#ifndef CONFIG_H
#define CONFIG_H

// WiFi Configuration
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Server Configuration
#define SERVER_URL "http://your-server.com/api/attendance"
#define SERVER_TIMEOUT 10000  // milliseconds

// Sui Blockchain Configuration
#define ORG_OBJECT_ID "0xYOUR_ORG_OBJECT_ID"

// Device Configuration
#define DEVICE_ID "ESP32_ATTENDANCE_001"

// RFID Module Pins
#define RFID_SS_PIN 5
#define RFID_RST_PIN 4

// Serial Configuration
#define SERIAL_BAUD_RATE 115200

// Timing Configuration
#define CARD_READ_DELAY 2000    // milliseconds between card reads
#define WIFI_RECONNECT_DELAY 5000  // milliseconds before reconnecting WiFi
#define MAIN_LOOP_DELAY 100     // milliseconds in main loop

// Debug Configuration
#define DEBUG_MODE true
#define DEBUG_SERIAL Serial

#endif // CONFIG_H








