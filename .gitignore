# ============================================
# Root .gitignore for ESP32 Sui Attendance System
# ============================================

# Node.js dependencies
node_modules/
**/node_modules/

# Environment files for different networks
.env
.env.local
.env.*.local
.env.mainnet
.env.mainnnet
.env.testnet
.env.development
.env.production

# TypeScript build artifacts
dist/
build/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# OS / editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Python (if any scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Sui / Move specific
.move/
*.mv
.move_history/

# Coverage reports
coverage/
*.lcov
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# IDE specific
*.code-workspace
.vscode/
.idea/
*.iml

# System files
.DS_Store
Thumbs.db
desktop.ini

